# Supabase › Project Settings › API Keys
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx   # ou a anon key (legado)
SUPABASE_SECRET_KEY=sb_secret_xxx                          # ou a service_role key (legado) — NUNCA expor no client

# "producao" | "hlg" — badge de ambiente na tela (HLG = amarelo)
NEXT_PUBLIC_APP_ENV=producao
